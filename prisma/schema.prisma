// Biometric Center Model
model BiometricCenter {
  id           String @id @default(uuid())
  name         String @unique // e.g., "ASFAAR-ABUJA HQ"
  code         String @unique // e.g., "ASFAAR-ABJ-HQ" for internal reference
  centerNumber String @unique // e.g., "001" - Unique 3-digit center number for reference generation

  // Location Details
  address    String // Full address
  city       String // City name
  state      String // State/Province
  country    String  @default("Nigeria")
  postalCode String? // Postal/ZIP code

  // Contact Information
  phone   String? // Phone number
  email   String? // Email address
  website String? // Website URL

  // Operational Details
  isActive    Boolean  @default(true) // Whether center is operational
  capacity    Int? // Daily appointment capacity
  openingTime String? // Opening time (e.g., "09:00")
  closingTime String? // Closing time (e.g., "17:00")
  workingDays String[] // Days of operation (e.g., ["MONDAY", "TUESDAY", ...])

  // Scheduling
  appointmentDuration Int @default(30) // Duration per appointment in minutes
  bufferTime          Int @default(15) // Buffer time between appointments

  // Services
  servicesOffered   String[] // Services available at this center
  specialFacilities String[] // Special facilities (wheelchair access, etc.)

  // Staff and Management
  // Note: Multiple managers can manage the same center (many-to-many relationship)

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Admin who created the center
  lastModifiedBy String? // Last person who modified

  // Relations
  appointments BiometricAppointment[]
  booths       Booth[]
  queueEntries QueueEntry[]
  staff        User[]                 @relation("CenterStaff") // Staff who have access to this center

  @@index([city])
  @@index([state])
  @@index([isActive])
  @@index([createdAt])
  @@map("biometric_centers")
}

// Booth Model
model Booth {
  id       String          @id @default(uuid())
  centerId String
  center   BiometricCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  // Booth Details
  boothNumber      String // e.g., "A1", "B2", "VIP-1"
  appointmentClass AppointmentClass // VIP, PREMIUM, REGULAR
  isActive         Boolean          @default(true)
  isOccupied       Boolean          @default(false)

  // Equipment/Capabilities
  hasCamera             Boolean @default(true)
  hasFingerprintScanner Boolean @default(true)
  hasSignaturePad       Boolean @default(false)

  // Current Assignment
  agentId String?
  agent   User?   @relation("BoothAgent", fields: [agentId], references: [id])

  // Relations
  queueEntries      QueueEntry[]
  biometricSessions BiometricSession[]

  // Audit
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  lastModifiedBy String?

  @@unique([centerId, boothNumber])
  @@index([centerId])
  @@index([appointmentClass])
  @@index([isActive, isOccupied])
  @@map("booths")
}

// Queue Entry Model
model QueueEntry {
  id String @id @default(uuid())

  // Appointment Reference
  appointmentId String               @unique
  appointment   BiometricAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Queue Details
  centerId         String
  center           BiometricCenter  @relation(fields: [centerId], references: [id])
  appointmentClass AppointmentClass

  // Queue Position & Status
  queueNumber Int         @default(autoincrement()) // Auto-generated sequential number
  status      QueueStatus @default(WAITING)
  priority    Int         @default(0) // Higher number = higher priority

  // Timestamps
  joinedAt    DateTime  @default(now())
  calledAt    DateTime? // When called to booth
  startedAt   DateTime? // When biometric capture started
  completedAt DateTime? // When biometric capture completed

  // Booth Assignment
  boothId String?
  booth   Booth?  @relation(fields: [boothId], references: [id])

  // Estimated times
  estimatedWaitTime    Int? // In minutes
  estimatedServiceTime Int? // In minutes

  // Relations
  biometricSession BiometricSession?

  @@index([centerId, appointmentClass, queueNumber])
  @@index([status, joinedAt])
  @@index([centerId, status])
  @@map("queue_entries")
}

// Biometric Session Model
model BiometricSession {
  id String @id @default(uuid())

  // References
  appointmentId String               @unique
  appointment   BiometricAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  queueEntryId  String               @unique
  queueEntry    QueueEntry           @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  boothId       String
  booth         Booth                @relation(fields: [boothId], references: [id])
  agentId       String
  agent         User                 @relation("BiometricAgent", fields: [agentId], references: [id])

  // Biometric Data Capture Status
  fingerprintsCaptured Boolean @default(false)
  photoCaptured        Boolean @default(false)
  signatureCaptured    Boolean @default(false)

  // Files/References
  photoUrl        String?
  fingerprintData Json? // Encrypted biometric data
  signatureUrl    String?

  // Session Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int? // In seconds

  // Quality Checks
  photoQualityScore       Float?
  fingerprintQualityScore Float?
  requiresRetake          Boolean @default(false)
  retakeReason            String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([boothId])
  @@index([agentId])
  @@index([startedAt])
  @@map("biometric_sessions")
}

// Biometric Appointment Enums
enum AppointmentClass {
  REGULAR
  VIP
  PREMIUM
}

enum AppointmentStatus {
  PENDING // Initial status when appointment is created
  SCHEDULED // When date/time is set but payment not completed
  ACTIVE // When application is completed AND payment is made
  CHECKED_IN // ✅ NEW: Applicant checked in by gatehouse
  IN_QUEUE // ✅ NEW: Added to queue by receptionist
  AT_BOOTH // ✅ NEW: Currently being processed
  COMPLETED // When biometric capture is done
  CANCELLED // When appointment is cancelled
  RESCHEDULED // When appointment is rescheduled
  NO_SHOW // When applicant doesn't show up
}

// Biometric Appointment Model
model BiometricAppointment {
  id String @id @default(uuid())

  // Relations
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String         @unique // One appointment per form submission
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Biometric Center Relation (instead of enum)
  centerId String
  center   BiometricCenter @relation(fields: [centerId], references: [id])

  // Appointment Details
  appointmentClass AppointmentClass  @default(REGULAR)
  status           AppointmentStatus @default(PENDING)

  // Date and Time
  appointmentTime DateTime? // Full date-time for the appointment

  // Requirements and Notes
  specialRequirements String? // Any special requirements or accessibility needs
  adminNotes          String? // Internal notes by admin/staff

  // Acknowledgments
  confirmationAcknowledged Boolean @default(false) // User confirmed appointment
  consentAcknowledged      Boolean @default(false) // User gave biometric consent
  termsAcknowledged        Boolean @default(false) // User agreed to terms

  // Reminder System
  reminderSent   Boolean   @default(false) // Whether reminder was sent
  reminderSentAt DateTime? // When reminder was sent

  // Check-in Status (Handled by Gatehouse)
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?
  checkedInBy String? // Staff member who checked them in

  // Rescheduling History
  originalAppointmentDate DateTime? // Original date if rescheduled
  rescheduleReason        String? // Reason for rescheduling
  rescheduleCount         Int       @default(0) // Number of times rescheduled

  // Biometric Capture Results
  biometricsCaptured Boolean   @default(false) // Whether biometrics were captured
  capturedAt         DateTime? // When biometrics were captured
  capturedBy         String? // Staff member who captured biometrics
  captureQuality     String? // Quality assessment of captured biometrics

  // Relations
  queueEntry       QueueEntry?
  biometricSession BiometricSession?

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Admin/staff who created the appointment
  lastModifiedBy String? // Last person who modified the appointment

  // Indexes for performance
  @@index([userId])
  @@index([submissionId])
  @@index([centerId])
  @@index([appointmentTime])
  @@index([status])
  @@index([appointmentClass])
  @@index([createdAt])
  @@map("biometric_appointments")
}

// Payment Enums (reusing existing PaymentStatus)
enum Currency {
  USD
  NGN
  EUR
  GBP
}

// Using existing PaymentMethodType enum

// Payment Model
model Payment {
  id String @id @default(uuid())

  // Relations
  submissionId String?         @unique // One payment per form submission (optional for onboarding)
  submission   FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // User who made the payment (REQUIRED for onboarding payments)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Many-to-many relationship with service fees
  serviceFees PaymentServiceFee[]

  // Payment Details
  amount      Float
  currency    Currency           @default(NGN)
  status      PaymentStatus      @default(PENDING)
  methodType  PaymentMethodType? // Type of payment method used
  description String? // What the payment is for

  // Payment Processor Integration
  processorId       String? // Stripe/Paystack/Flutterwave transaction ID
  processor         PaymentProvider? // Which payment processor was used
  processorResponse Json? // Full response from payment processor

  // Payment Metadata
  invoiceNumber String? @unique // Internal invoice number
  reference     String? @unique // payment reference number
  receiptUrl    String? // URL to payment receipt
  refundReason  String? // Reason for refund if applicable
  refundAmount  Float? // Amount refunded

  // Timestamps
  paidAt     DateTime? // When payment was completed
  failedAt   DateTime? // When payment failed
  refundedAt DateTime? // When payment was refunded
  expiresAt  DateTime? // When payment link expires

  // Audit Fields
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String? // Who initiated the payment
  lastModifiedBy  String? // Last person who modified
  PaymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String?

  // Back-relations
  upgradeApplication TravelAgentUpgradeApplication?
  licenseRenewal     TravelAgentLicenseRenewal?

  // Indexes for performance
  @@index([submissionId])
  @@index([userId])
  @@index([status])
  @@index([amount])
  @@index([currency])
  @@index([processorId])
  @@index([paidAt])
  @@index([createdAt])
  @@map("payments")
}

// Junction table for Payment <-> ServiceFee many-to-many relationship
model PaymentServiceFee {
  id           String     @id @default(uuid())
  paymentId    String
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  serviceFeeId String
  serviceFee   ServiceFee @relation(fields: [serviceFeeId], references: [id], onDelete: Cascade)

  // Additional fields for the relationship
  amount   Float // Amount for this specific service fee
  currency String   @default("NGN")
  feeType  FeeType? // Fee type for this specific service fee

  createdAt DateTime @default(now())

  @@unique([paymentId, serviceFeeId])
  @@index([paymentId])
  @@index([serviceFeeId])
  @@map("payment_service_fees")
}

