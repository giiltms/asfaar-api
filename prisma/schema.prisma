enum SubmissionStatus {
  // Initial States
  DRAFT
  PENDING_PAYMENT // application submitted but payment not yet confirmed
  SUBMITTED // applicant submits an application

  // Review States
  UNDER_REVIEW // when the application is ready for a verification officer
  FLAGGED // when it should go to security
  QUERIED // when there is something wrong with the documents or information provided

  // Processing States
  PROCESSING // when embassy is processing the application
  PENDING_BIOMETRICS // when the user has an appointment and is yet to do biometrics

  // Final States
  APPROVED // embassy approves it
  REJECTED // embassy rejects the application
  CANCELLED // applicant cancels the application
}

enum AddressType {
