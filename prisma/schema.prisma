generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum Roles {
  SUPER_ADMIN
  ADMIN
  APPLICANT
  AGENCY
  FINANCE
  EMBASSY_OFFICER
  LIAISON_OFFICER
  VERIFICATION_OFFICER
  BIOMETRIC_AGENT
  CENTER_MANAGER
  RECEPTIONIST
  GATEHOUSE
  AUTHORITY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  WALLET
  USSD
  QR_CODE
  CRYPTO
  MOBILE_MONEY
}

enum PaymentProvider {
  FLUTTERWAVE
  PAYSTACK
  FINCRA
  STRIPE
  PAYPAL
}

enum FeeType {
  ONBOARDING
  APPLICATION
  UPGRADE
  RESCHEDULING
  ADDITIONAL_CHARGE
}

model ServiceFee {
  id          String            @id @default(uuid())
  name        String
  description String?
  amount      Int
  currency    String            @default("NGN")
  providers   PaymentProvider[]
  metadata    Json?
  isOptional  Boolean           @default(true)
  isActive    Boolean           @default(true)

  feeType FeeType?

  submissions        FormSubmission[]
  forms              DynamicForm[]
  paymentServiceFees PaymentServiceFee[] // NEW: Payments using this service fee

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
  TRANSFER
  SUBSCRIPTION
  WITHDRAWAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  PAST_DUE
  SUSPENDED
}

enum QueueStatus {
  WAITING // In queue, waiting to be called
  CALLED // Called to booth but not started service
  IN_PROGRESS // Biometric capture in progress
  COMPLETED // Service completed
  NO_SHOW // Didn't show up when called
  CANCELLED // Cancelled while in queue
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  phone          String?   @unique
  firstName      String?
  middleName     String?
  lastName       String?
  username       String?   @unique
  gender         Gender?
  dateOfBirth    DateTime?
  password       String
  avatar         String?
  bio            String?
  website        String?
  // Removed location - replaced with addresses relation
  nin            String? // National Identity Number
  ninVerified    Boolean   @default(false) // NIN verification status
  state          String? // User's state
  lga            String? // Local Government Area
  timezone       String?   @default("UTC")
  locale         String?   @default("en")
  roles          Roles[]   @default([APPLICANT])
  status         Status    @default(ACTIVE)
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  onboardingPaid Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  tokens        Token[]
  auditLogs     AuditLog[]       @relation("UserAudit")
  profile       UserProfile?
  preferences   UserPreference[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  files         File[]
  notifications Notification[]
  sessions      UserSession[]
  addresses     Address[] // User addresses relation
  departments   Department[]     @relation("DepartmentStaff")
  country       Country?         @relation(fields: [countryId], references: [id])
  countryId     String?

  // Payment relations
  paymentMethods              PaymentMethod[]
  transactions                Transaction[]
  subscriptions               Subscription[]
  wallets                     Wallet[]
  payments                    Payment[] // NEW: User's payments
  formSubmissions             FormSubmission[]
  travelAgentSubmissions      FormSubmission[]                @relation("TravelAgentSubmission")
  ninVerifications            NinVerification[]
  biometricCenters            BiometricCenter[]               @relation("CenterStaff")
  biometricAppointments       BiometricAppointment[]
  booths                      Booth[]                         @relation("BoothAgent")
  biometricSessions           BiometricSession[]              @relation("BiometricAgent")
  biometricData               BiometricData[]
  internationalPassports      InternationalPassport[]
  // Travel Agent Upgrade & Licensing
  upgradeApplications         TravelAgentUpgradeApplication[]
  reviewedUpgradeApplications TravelAgentUpgradeApplication[] @relation("UpgradeReviewer")
  travelAgentLicense          TravelAgentLicense?

  @@map("users")
}

model InternationalPassport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Passport Details
  passportNumber       String
  passportType         String   @default("ORDINARY") // ORDINARY, DIPLOMATIC, OFFICIAL, EMERGENCY
  passportIssueDate    DateTime
  passportExpiryDate   DateTime
  passportIssueCountry String // ISO 3166-1 alpha-3 country code

  // Document Photos
  passportPhoto      String? // Main passport photo
  passportFrontPhoto String? // Front page scan
  passportBackPhoto  String? // Back page scan

  // Verification & Status
  isVerified         Boolean   @default(false)
  verificationStatus String? // PENDING, VERIFIED, REJECTED, EXPIRED
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?

  // Document Metadata
  passportMetadata Json? // Additional passport data (MRZ, etc.)
  documentHash     String? // Hash for integrity verification
  documentSize     Int? // File size in bytes

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  lastModifiedBy String?

  // Constraints
  @@unique([userId, passportNumber]) // One passport number per user
  @@index([passportNumber])
  @@index([passportExpiryDate])
  @@index([isVerified])
  @@index([verificationStatus])
  @@map("international_passports")
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          String?
  jobTitle         String?
  education        String?
  skills           String[]
  interests        String[]
  socialLinks      Json?
  address          Json?
  emergencyContact Json?
  customFields     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_profiles")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  category  String?  @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("user_preferences")
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo Json?
  ipAddress  String?
  userAgent  String?
  isActive   Boolean  @default(true)
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("user_sessions")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  color       String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  posts Post[]
  tags  Tag[]

  @@map("categories")
}

model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isActive    Boolean   @default(true)
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  posts Post[] @relation("PostTags")

  @@map("tags")
}

model Post {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String?
  excerpt       String?
  featuredImage String?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  status        Status    @default(PENDING)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tags     Tag[]     @relation("PostTags")
  comments Comment[]
  likes    Like[]
  files    File[]    @relation("PostFiles")

  @@map("posts")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  status    Status    @default(ACTIVE)
  likeCount Int       @default(0)
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("likes")
}

model File {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String?
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  postId       String?
  post         Post?    @relation("PostFiles", fields: [postId], references: [id])
  isPublic     Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("files")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("info")
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String   @default("NGN")
  balance   Decimal  @default(0) @db.Decimal(19, 2)
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fromTransactions Transaction[] @relation("FromWallet")
  toTransactions   Transaction[] @relation("ToWallet")

  @@unique([userId, currency])
  @@map("wallets")
}

model PaymentMethod {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         PaymentProvider
  type             PaymentMethodType
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  providerMethodId String? // Provider's payment method ID
  last4            String? // Last 4 digits for cards
  brand            String? // Card brand (Visa, Mastercard, etc.)
  expiryMonth      Int?
  expiryYear       Int?
  bankName         String?
  accountNumber    String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  transactions Transaction[]
  Payment      Payment[]

  @@map("payment_methods")
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  type              TransactionType
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(19, 2)
  currency          String          @default("NGN")
  description       String?
  reference         String          @unique
  providerReference String? // Provider's transaction reference
  provider          PaymentProvider
  paymentMethodId   String?
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])

  // Wallet transfer fields
  fromWalletId String?
  fromWallet   Wallet? @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWalletId   String?
  toWallet     Wallet? @relation("ToWallet", fields: [toWalletId], references: [id])

  // Fees and charges
  fee       Decimal? @db.Decimal(19, 2)
  netAmount Decimal? @db.Decimal(19, 2)

  // Provider response data
  providerData Json?
  webhookData  Json?

  // Subscription relation
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // Timestamps
  processedAt DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  refunds TransactionRefund[]

  @@map("transactions")
}

model TransactionRefund {
  id                String        @id @default(uuid())
  transactionId     String
  transaction       Transaction   @relation(fields: [transactionId], references: [id])
  amount            Decimal       @db.Decimal(19, 2)
  reason            String?
  status            PaymentStatus @default(PENDING)
  reference         String        @unique
  providerReference String?
  providerData      Json?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("transaction_refunds")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  price         Decimal  @db.Decimal(19, 2)
  currency      String   @default("NGN")
  interval      String // monthly, yearly, weekly
  intervalCount Int      @default(1)
  trialDays     Int?     @default(0)
  features      Json?
  metadata      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  cancelledAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  transactions Transaction[]

  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("UserAudit", fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  url        String?
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}

model Token {
  id        String       @id @default(uuid())
  userId    String
  owner     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      TokenType    @default(OTP)
  useCase   TokenUseCase
  isUsed    Boolean      @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("tokens")
}

model TokenWhiteList {
  id             String    @id @default(uuid())
  userId         String
  accessToken    String?
  refreshToken   String?
  refreshTokenId String?
  deviceInfo     Json?
  ipAddress      String?
  isRevoked      Boolean   @default(false)
  revokedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("token_whitelist")
}

enum TokenUseCase {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
  PHONE_VERIFICATION
  LOGIN_VERIFICATION
  ACCOUNT_RECOVERY
}

enum TokenType {
  OTP
  HEX
  UUID
  JWT
}

// Country model for managing visa destinations and forms
model Country {
  id           String  @id @default(uuid())
  name         String  @unique // e.g., "Saudi Arabia"
  isoCode2     String  @unique @db.VarChar(2) // e.g., "SA" (ISO 3166-1 alpha-2)
  isoCode3     String  @unique @db.VarChar(3) // e.g., "SAU" (ISO 3166-1 alpha-3)
  numericCode  String  @unique @db.VarChar(3) // e.g., "682" (ISO 3166-1 numeric)
  currency     String? // e.g., "SAR"
  currencyName String? // e.g., "Saudi Riyal"
  dialCode     String? // e.g., "+966"
  region       String? // e.g., "Asia", "Africa"
  subregion    String? // e.g., "Western Asia"
  capital      String? // e.g., "Riyadh"
  flag         String? // Flag emoji or URL
  logoUrl      String? // Country logo/emblem URL
  isActive     Boolean @default(true)

  // Form and application settings
  visaProcessingDays Int?     @default(14) // Expected processing time
  maxApplications    Int?     @default(1000) // Max applications per year
  applicationFee     Decimal? @db.Decimal(10, 2) // Base application fee

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  users               User[]
  forms               DynamicForm[]
  applicationCounters ApplicationCounter[]
  applicationTypes    ApplicationType[]

  @@map("countries")
}

// Application counter for generating unique reference numbers per country/year
model ApplicationCounter {
  id        String  @id @default(uuid())
  country   Country @relation(fields: [countryId], references: [id])
  countryId String
  year      Int
  counter   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, year])
  @@map("application_counters")
}

// Payment invoice counter for generating unique invoice numbers per month
model PaymentInvoiceCounter {
  id        String   @id @default(uuid())
  monthKey  String   @unique // Format: "202508" for August 2025
  counter   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_invoice_counters")
}

model DynamicForm {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  // Country-specific forms
  country   Country? @relation(fields: [countryId], references: [id])
  countryId String?

  // Single application type per form (reference by code)
  applicationType     ApplicationType? @relation(fields: [applicationTypeCode], references: [code])
  applicationTypeCode String?

  sections    FormSection[]
  submissions FormSubmission[]
  serviceFees ServiceFee[]

  @@map("dynamic_forms")
}

model FormSection {
  id          String      @id @default(uuid())
  form        DynamicForm @relation(fields: [formId], references: [id])
  formId      String
  title       String
  description String?
  order       Int
  config      Json?

  groups InputGroup[]
}

model InputGroup {
  id          String      @id @default(uuid())
  section     FormSection @relation(fields: [sectionId], references: [id])
  sectionId   String
  title       String?
  description String?
  order       Int
  repeatable  Boolean     @default(false)
  config      Json?

  fields FormField[]
}

model FormField {
  id                  String     @id @default(uuid())
  group               InputGroup @relation(fields: [groupId], references: [id])
  groupId             String
  label               String
  name                String // unique per form context
  type                FieldType
  required            Boolean    @default(false)
  placeholder         String?
  defaultValue        String?
  validation          Json? // e.g., { "minLength": 2, "pattern": "^[A-Z]+$" }
  config              Json? // e.g., { "rows": 3 }, { "prefix": "₦" }
  visibilityCondition Json? // e.g., { "field": "is_married", "value": "yes" }
  calculation         Json? // e.g., { "expression": "${income} - ${expenses}" }
  metadata            Json? // e.g., { "captureTimestamp": true }
  source              Json? // e.g., { "endpoint": "/api/states", "valueField": "id", "labelField": "name" }
  fileTypes           Json? // e.g., { "accept": [".pdf", ".jpg", ".png"], "maxSize": "5MB", "multiple": false }
  content             String?    @db.Text // For INFO and AGREEMENT fields to display content
  order               Int

  options   FieldOption[] // for SELECT / MULTISELECT
  responses FieldResponse[]
}

model FieldOption {
  id      String    @id @default(uuid())
  field   FormField @relation(fields: [fieldId], references: [id])
  fieldId String
  label   String // e.g., "Married"
  value   String // e.g., "MARRIED"
  order   Int
}

model FormSubmission {
  id              String      @id @default(uuid())
  referenceNumber String?     @unique // e.g., "SA25001234" - Generated when submitted
  form            DynamicForm @relation(fields: [formId], references: [id])
  formId          String
  userId          String // Changed from applicantId to userId for consistency
  user            User        @relation(fields: [userId], references: [id])

  // Travel agent
  travelAgentId String?
  travelAgent   User?   @relation("TravelAgentSubmission", fields: [travelAgentId], references: [id])

  // Enhanced Status Tracking
  status         SubmissionStatus  @default(DRAFT)
  previousStatus SubmissionStatus? // Track previous state for workflow

  // Direct Biometric Tracking
  biometricRequired    Boolean   @default(false)
  biometricCompleted   Boolean   @default(false)
  biometricCompletedAt DateTime?

  // Flag Management
  isFlagged  Boolean   @default(false)
  flagReason String? // Why it was flagged
  flaggedAt  DateTime?
  flaggedBy  String? // Staff member who flagged it

  // Query Management (requesting additional info from applicant)
  isQueried       Boolean   @default(false)
  queryMessage    String? // Message/question to applicant
  queryResponse   String? // Applicant's response
  queriedAt       DateTime?
  queryResponseAt DateTime?
  queriedBy       String? // Staff who queried

  // Direct Payment Tracking
  paymentRequired    Boolean   @default(false)
  paymentCompleted   Boolean   @default(false)
  paymentCompletedAt DateTime?

  // Cancellation Tracking (Soft Delete)
  isCancelled        Boolean   @default(false)
  cancelledAt        DateTime?
  cancelledBy        String? // User ID who cancelled
  cancellationReason String? // Reason for cancellation

  // Existing review fields
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String? // ID of the reviewer
  reviewNotes String? // Review comments
  metadata    Json? // Additional metadata for the submission
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  responses       FieldResponse[]
  serviceFees     ServiceFee[]
  totalServiceFee Float?
  statusLogs      SubmissionStatusLog[] // Audit trail for status changes

  appointment   BiometricAppointment?
  payment       Payment?
  biometricData BiometricData?

  // Flags raised against this submission
  flags Flag[]

  @@map("form_submissions")
}

// Audit trail for submission status changes
model SubmissionStatusLog {
  id           String         @id @default(uuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  fromStatus SubmissionStatus? // Previous status (null for initial status)
  toStatus   SubmissionStatus // New status
  reason     String? // Reason for status change
  notes      String? // Additional notes about the change

  changedBy String? // User ID who changed the status
  changedAt DateTime @default(now())

  @@index([submissionId, changedAt])
  @@map("submission_status_logs")
}

/// Flags raised by staff on a submission
model Flag {
  id           String         @id @default(uuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Who created the flag (staff user id from JWT)
  createdById String

  // Routing/ownership
  targetDepartment   Department @relation(fields: [targetDepartmentId], references: [id], name: "DepartmentFlagging")
  targetDepartmentId String

  // Categorization and priority
  flagType      FlagType
  priorityLevel PriorityLevel

  // Details
  reason String
  notes  String?

  // Lifecycle
  status       FlagStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions      FlagAction[]
  Department   Department?  @relation(fields: [departmentId], references: [id])
  departmentId String?

  @@index([submissionId, status, targetDepartmentId])
  @@map("flags")
