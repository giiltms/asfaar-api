// Biometric Data Model - Stores actual biometric data for users
model BiometricData {
  id String @id @default(uuid())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional relation to form submission if captured during application process
  submissionId String?         @unique
  submission   FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Photo Data
  photoUrl      String? // URL to stored photo
  photoHash     String? // Hash for integrity verification
  photoMetadata Json? // Additional photo metadata (dimensions, format, etc.)

  // Quality and Validation
  photoQualityScore Float? // Quality score 0-100 for photo
  // Note: Fingerprint quality scores are stored in individual FingerprintData records

  // Status and Validation
  isVerified         Boolean @default(false) // Whether data has been verified
  verificationStatus String? // PENDING, VERIFIED, REJECTED, NEEDS_RETAKES
  verificationNotes  String? // Notes from verification process

  // Capture Information
  capturedBy      String? // ID of the biometric agent who captured the data
  capturedAt      DateTime? // When the data was captured
  captureDevice   String? // Device used for capture
  captureLocation String? // Location where capture occurred

  // Security and Privacy
  isEncrypted         Boolean @default(true) // Whether data is encrypted
  encryptionKey       String? // Reference to encryption key (not the actual key)
  dataRetentionPolicy String? // How long to retain this data
  encryptionAlgorithm String? // e.g., "AES-256-GCM"
  keyVersion          String? // Version of encryption key used

  // Compliance & Standards
  templateStandard   String? // e.g., "ISO/IEC 19794-2:2005"
  captureStandard    String? // e.g., "ISO/IEC 19794-4:2005"
  dataClassification String  @default("CONFIDENTIAL") // Data classification level

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Who created this record
  lastModifiedBy String? // Last person who modified

  // 442 Fingerprint relation (individual fingers)
  fingerprintFingers FingerprintData[]

  // Note: submissionId is unique, ensuring one record per submission
  // Indexes for performance
  @@index([userId])
  @@index([submissionId])
  @@index([capturedAt])
  @@index([isVerified])
  @@index([verificationStatus])
  @@map("biometric_data")
}

// Finger Position Enum for 442 capture
enum FingerPosition {
  LEFT_THUMB
  LEFT_INDEX
  LEFT_MIDDLE
  LEFT_RING
  LEFT_LITTLE
  RIGHT_THUMB
  RIGHT_INDEX
  RIGHT_MIDDLE
  RIGHT_RING
  RIGHT_LITTLE
}

// Individual Finger Data Model for 442 captures
model FingerprintData {
  id String @id @default(uuid())

  // Relations
  biometricDataId String
  biometricData   BiometricData @relation(fields: [biometricDataId], references: [id], onDelete: Cascade)

  // Finger Information
  fingerPosition FingerPosition
  fingerName     String

  // ISO/IEC 19794-2:2005 Template Data
  templateData   Bytes? // Binary minutiae template (ISO/IEC 19794-2:2005)
  templateHash   String? // SHA-256 hash for integrity verification
  templateFormat String  @default("ISO19794-2:2005") // Template format standard

  // Optional WSQ Image Storage for Future Reprocessing
  wsqImageData Bytes? // WSQ-compressed raw fingerprint image
  wsqImageHash String? // Hash for WSQ image integrity
  wsqImageSize Int? // Size of WSQ image in bytes

  // Quality Information (NFIQ scoring)
  nfiqScore       Int? // NFIQ quality score (1-5, where 1-3 are acceptable)
  qualityScore    Float? // Additional quality metrics (0-100)
  captureAttempts Int     @default(1)
  isAcceptable    Boolean @default(false)
  isTemplateValid Boolean @default(false) // Template conformance validation

  // Capture Details
  capturedAt      DateTime?
  captureDevice   String? // e.g., "Suprema RealScan-G10"
  captureMethod   String? // "SLAP" or "INDIVIDUAL"
  captureLocation String? // Physical location of capture

  // Security & Encryption
  isEncrypted   Boolean @default(true)
  encryptionKey String? // Reference to encryption key (not actual key)

  // Metadata
  metadata Json? // Additional capture metadata

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Who captured this data
  lastModifiedBy String? // Last person who modified

  // Indexes & Constraints
  @@unique([biometricDataId, fingerPosition])
  @@index([biometricDataId])
  @@index([fingerPosition])
  @@index([nfiqScore])
  @@index([isAcceptable])
  @@index([isTemplateValid])
  @@index([biometricDataId, isAcceptable])
  @@index([capturedAt])
  @@map("fingerprint_data")
}
