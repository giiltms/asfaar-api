generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum Roles {
  SUPER_ADMIN
  ADMIN
  APPLICANT
  AGENCY
  ASFAAR_ADMIN
  EMBASSY_OFFICER
  SECURITY_OFFICER
  VERIFICATION_OFFICER
  BIOMETRIC_AGENT
  BIOMETRIC_SUPERVISOR
  RECEPTIONIST
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  WALLET
  USSD
  QR_CODE
  CRYPTO
  MOBILE_MONEY
}

enum PaymentProvider {
  FLUTTERWAVE
  PAYSTACK
  FINCRA
  STRIPE
  PAYPAL
}

model ServiceFee {
  id          String            @id @default(uuid())
  name        String
  description String?
  amount      Int
  currency    String            @default("NGN")
  providers   PaymentProvider[]
  metadata    Json?
  isOptional  Boolean           @default(true)
  isActive    Boolean           @default(true)

  submissions FormSubmission[]
  forms       DynamicForm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
  TRANSFER
  SUBSCRIPTION
  WITHDRAWAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  PAST_DUE
  SUSPENDED
}

enum QueueStatus {
  WAITING // In queue, waiting to be called
  CALLED // Called to booth but not started service
  IN_PROGRESS // Biometric capture in progress
  COMPLETED // Service completed
  NO_SHOW // Didn't show up when called
  CANCELLED // Cancelled while in queue
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  phone          String?   @unique
  firstName      String?
  middleName     String?
  lastName       String?
  username       String?   @unique
  gender         Gender?
  dateOfBirth    DateTime?
  password       String
  avatar         String?
  bio            String?
  website        String?
  // Removed location - replaced with addresses relation
  nin            String? // National Identity Number
  state          String? // User's state
  lga            String? // Local Government Area
  timezone       String?   @default("UTC")
  locale         String?   @default("en")
  roles          Roles[]   @default([APPLICANT])
  status         Status    @default(ACTIVE)
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  onboardingPaid Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  tokens        Token[]
  auditLogs     AuditLog[]       @relation("UserAudit")
  profile       UserProfile?
  preferences   UserPreference[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  files         File[]
  notifications Notification[]
  sessions      UserSession[]
  addresses     Address[] // User addresses relation

  // Payment relations
  paymentMethods        PaymentMethod[]
  transactions          Transaction[]
  subscriptions         Subscription[]
  wallets               Wallet[]
  FormSubmission        FormSubmission[]
  ninVerifications      NinVerification[]
  biometricCenters      BiometricCenter[]      @relation("CenterManager")
  biometricAppointments BiometricAppointment[]
  booths                Booth[]                @relation("BoothAgent")
  biometricSessions     BiometricSession[]     @relation("BiometricAgent")

  @@map("users")
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          String?
  jobTitle         String?
  education        String?
  skills           String[]
  interests        String[]
  socialLinks      Json?
  address          Json?
  emergencyContact Json?
  customFields     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_profiles")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  category  String?  @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("user_preferences")
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo Json?
  ipAddress  String?
  userAgent  String?
  isActive   Boolean  @default(true)
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("user_sessions")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  color       String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  posts Post[]
  tags  Tag[]

  @@map("categories")
}

model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isActive    Boolean   @default(true)
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  posts Post[] @relation("PostTags")

  @@map("tags")
}

model Post {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String?
  excerpt       String?
  featuredImage String?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  status        Status    @default(PENDING)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tags     Tag[]     @relation("PostTags")
  comments Comment[]
  likes    Like[]
  files    File[]    @relation("PostFiles")

  @@map("posts")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  status    Status    @default(ACTIVE)
  likeCount Int       @default(0)
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("likes")
}

model File {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String?
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  postId       String?
  post         Post?    @relation("PostFiles", fields: [postId], references: [id])
  isPublic     Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("files")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("info")
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String   @default("NGN")
  balance   Decimal  @default(0) @db.Decimal(19, 2)
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fromTransactions Transaction[] @relation("FromWallet")
  toTransactions   Transaction[] @relation("ToWallet")

  @@unique([userId, currency])
  @@map("wallets")
}

model PaymentMethod {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         PaymentProvider
  type             PaymentMethodType
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  providerMethodId String? // Provider's payment method ID
  last4            String? // Last 4 digits for cards
  brand            String? // Card brand (Visa, Mastercard, etc.)
  expiryMonth      Int?
  expiryYear       Int?
  bankName         String?
  accountNumber    String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  transactions Transaction[]
  Payment      Payment[]

  @@map("payment_methods")
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  type              TransactionType
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(19, 2)
  currency          String          @default("NGN")
  description       String?
  reference         String          @unique
  providerReference String? // Provider's transaction reference
  provider          PaymentProvider
  paymentMethodId   String?
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])

  // Wallet transfer fields
  fromWalletId String?
  fromWallet   Wallet? @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWalletId   String?
  toWallet     Wallet? @relation("ToWallet", fields: [toWalletId], references: [id])

  // Fees and charges
  fee       Decimal? @db.Decimal(19, 2)
  netAmount Decimal? @db.Decimal(19, 2)

  // Provider response data
  providerData Json?
  webhookData  Json?

  // Subscription relation
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // Timestamps
  processedAt DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  refunds TransactionRefund[]

  @@map("transactions")
}

model TransactionRefund {
  id                String        @id @default(uuid())
  transactionId     String
  transaction       Transaction   @relation(fields: [transactionId], references: [id])
  amount            Decimal       @db.Decimal(19, 2)
  reason            String?
  status            PaymentStatus @default(PENDING)
  reference         String        @unique
  providerReference String?
  providerData      Json?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("transaction_refunds")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  price         Decimal  @db.Decimal(19, 2)
  currency      String   @default("NGN")
  interval      String // monthly, yearly, weekly
  intervalCount Int      @default(1)
  trialDays     Int?     @default(0)
  features      Json?
  metadata      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  cancelledAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  transactions Transaction[]

  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("UserAudit", fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  url        String?
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}

model Token {
  id        String       @id @default(uuid())
  userId    String
  owner     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      TokenType    @default(OTP)
  useCase   TokenUseCase
  isUsed    Boolean      @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("tokens")
}

model TokenWhiteList {
  id             String    @id @default(uuid())
  userId         String
  accessToken    String?
  refreshToken   String?
  refreshTokenId String?
  deviceInfo     Json?
  ipAddress      String?
  isRevoked      Boolean   @default(false)
  revokedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("token_whitelist")
}

enum TokenUseCase {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
  PHONE_VERIFICATION
  LOGIN_VERIFICATION
  ACCOUNT_RECOVERY
}

enum TokenType {
  OTP
  HEX
  UUID
  JWT
}

// Country model for managing visa destinations and forms
model Country {
  id           String  @id @default(uuid())
  name         String  @unique // e.g., "Saudi Arabia"
  isoCode2     String  @unique @db.VarChar(2) // e.g., "SA" (ISO 3166-1 alpha-2)
  isoCode3     String  @unique @db.VarChar(3) // e.g., "SAU" (ISO 3166-1 alpha-3)
  numericCode  String  @unique @db.VarChar(3) // e.g., "682" (ISO 3166-1 numeric)
  currency     String? // e.g., "SAR"
  currencyName String? // e.g., "Saudi Riyal"
  dialCode     String? // e.g., "+966"
  region       String? // e.g., "Asia", "Africa"
  subregion    String? // e.g., "Western Asia"
  capital      String? // e.g., "Riyadh"
  flag         String? // Flag emoji or URL
  isActive     Boolean @default(true)

  // Form and application settings
  visaProcessingDays Int?     @default(14) // Expected processing time
  maxApplications    Int?     @default(1000) // Max applications per year
  applicationFee     Decimal? @db.Decimal(10, 2) // Base application fee

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  forms               DynamicForm[]
  applicationCounters ApplicationCounter[]

  @@map("countries")
}

// Application counter for generating unique reference numbers per country/year
model ApplicationCounter {
  id        String  @id @default(uuid())
  country   Country @relation(fields: [countryId], references: [id])
  countryId String
  year      Int
  counter   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, year])
  @@map("application_counters")
}

model DynamicForm {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  // Country-specific forms
  country   Country? @relation(fields: [countryId], references: [id])
  countryId String?

  sections    FormSection[]
  submissions FormSubmission[]
  serviceFees ServiceFee[]

  @@map("dynamic_forms")
}

model FormSection {
  id          String      @id @default(uuid())
  form        DynamicForm @relation(fields: [formId], references: [id])
  formId      String
  title       String
  description String?
  order       Int

  groups InputGroup[]
}

model InputGroup {
  id          String      @id @default(uuid())
  section     FormSection @relation(fields: [sectionId], references: [id])
  sectionId   String
  title       String?
  description String?
  order       Int
  repeatable  Boolean     @default(false)

  fields FormField[]
}

model FormField {
  id                  String     @id @default(uuid())
  group               InputGroup @relation(fields: [groupId], references: [id])
  groupId             String
  label               String
  name                String // unique per form context
  type                FieldType
  required            Boolean    @default(false)
  placeholder         String?
  defaultValue        String?
  validation          Json? // e.g., { "minLength": 2, "pattern": "^[A-Z]+$" }
  config              Json? // e.g., { "rows": 3 }, { "prefix": "₦" }
  visibilityCondition Json? // e.g., { "field": "is_married", "value": "yes" }
  calculation         Json? // e.g., { "expression": "${income} - ${expenses}" }
  metadata            Json? // e.g., { "captureTimestamp": true }
  order               Int

  options   FieldOption[] // for SELECT / MULTISELECT
  responses FieldResponse[]
}

model FieldOption {
  id      String    @id @default(uuid())
  field   FormField @relation(fields: [fieldId], references: [id])
  fieldId String
  label   String // e.g., "Married"
  value   String // e.g., "MARRIED"
  order   Int
}

model FormSubmission {
  id              String           @id @default(uuid())
  referenceNumber String?          @unique // e.g., "SA25001234" - Generated when submitted
  form            DynamicForm      @relation(fields: [formId], references: [id])
  formId          String
  userId          String // Changed from applicantId to userId for consistency
  user            User             @relation(fields: [userId], references: [id])
  status          SubmissionStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String? // ID of the reviewer
  reviewNotes     String? // Review comments
  metadata        Json? // Additional metadata for the submission
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  responses       FieldResponse[]
  serviceFees     ServiceFee[]
  totalServiceFee Float?

  appointment BiometricAppointment?
  payment     Payment?

  @@map("form_submissions")
}

model FieldResponse {
  id           String         @id @default(uuid())
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  field        FormField      @relation(fields: [fieldId], references: [id])
  fieldId      String // Changed from formFieldId to fieldId
  fieldName    String // Added for easier reference
  value        String? // stringified value (text, select value, etc.)
  fileUrls     String[] // for file inputs
  metadata     Json? // Additional metadata for the response
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("field_responses")
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
  FILE
  SIGNATURE
  GEOLOCATION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED // Added APPROVED status
  REJECTED
}

enum AddressType {
  HOME
  WORK
  BUSINESS
  BILLING
  SHIPPING
  EMERGENCY_CONTACT
  CURRENT_RESIDENCE
  PERMANENT_RESIDENCE
}

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Address Components (International compatibility)
  addressLine1 String? // House number + Street name
  addressLine2 String? // Apartment, suite, floor, etc.
  area         String? // District/Area/Neighborhood
  city         String? // City/Town
  lga          String? // Local Government Area (Nigeria specific)
  state        String? // State/Province
  postalCode   String? // Postal/ZIP code
  country      String  @default("Nigeria")

  // Address Type and Status
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)
  isVerified Boolean     @default(false)

  // Optional coordinates for mapping
  latitude  Float?
  longitude Float?

  // Additional metadata
  label        String? // Custom label like "Office", "Parents' House"
  instructions String? // Delivery instructions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

model TempNINData {
  id                      String    @id @default(cuid())
  nin                     String    @unique
  firstName               String
  middleName              String?
  lastName                String
  fullName                String?
  dateOfBirth             String
  gender                  String
  phoneNumber             String?
  verifiedPhoneNumber     String?
  photo                   String?
  addressLine1            String
  addressLine2            String?
  city                    String?
  state                   String
  lga                     String
  postalCode              String?
  country                 String    @default("Nigeria")
  birthState              String?
  birthLga                String?
  trackingId              String?
  verified                Boolean   @default(false)
  verificationId          String?
  verificationStatus      String?
  verificationMethod      String?
  verificationDate        DateTime?
  verificationAttempts    Int       @default(1)
  lastVerificationAttempt DateTime?
  rawData                 Json?

  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum VerificationMethod {
  YOUVERIFY
  TEST_MODE
  MANUAL
  API
}

model NinVerification {
  id                  String    @id @default(uuid())
  nin                 String    @unique @db.VarChar(11)
  firstName           String?   @db.VarChar(100)
  middleName          String?   @db.VarChar(100)
  lastName            String?   @db.VarChar(100)
  fullName            String?   @db.VarChar(300)
  dateOfBirth         DateTime?
  gender              Gender?
  phoneNumber         String?   @db.VarChar(20)
  verifiedPhoneNumber String?   @db.VarChar(20)
  photo               String?   @db.Text

  // Address fields
  addressLine1 String? @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  lga          String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  country      String  @default("Nigeria") @db.VarChar(100)

  // Birth place fields
  birthState String? @db.VarChar(100)
  birthLga   String? @db.VarChar(100)

  // Verification fields
  verificationStatus      VerificationStatus @default(PENDING)
  verificationMethod      VerificationMethod @default(YOUVERIFY)
  verificationId          String?            @db.VarChar(255)
  trackingId              String?            @db.VarChar(255)
  verificationDate        DateTime?
  rawData                 Json?
  metadata                Json?
  errorMessage            String?            @db.Text
  verificationAttempts    Int                @default(1)
  lastVerificationAttempt DateTime?

  // User who initiated verification (optional)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Audit trail
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nin])
  @@index([verificationStatus])
  @@index([verificationMethod])
  @@index([createdAt])
  @@index([userId])
  @@map("nin_verifications")
}

// Biometric Center Model
model BiometricCenter {
  id   String @id @default(uuid())
  name String @unique // e.g., "ASFAAR-ABUJA HQ"
  code String @unique // e.g., "ASFAAR-ABJ-HQ" for internal reference

  // Location Details
  address    String // Full address
  city       String // City name
  state      String // State/Province
  country    String  @default("Nigeria")
  postalCode String? // Postal/ZIP code

  // Contact Information
  phone   String? // Phone number
  email   String? // Email address
  website String? // Website URL

  // Operational Details
  isActive    Boolean  @default(true) // Whether center is operational
  capacity    Int? // Daily appointment capacity
  openingTime String? // Opening time (e.g., "09:00")
  closingTime String? // Closing time (e.g., "17:00")
  workingDays String[] // Days of operation (e.g., ["MONDAY", "TUESDAY", ...])

  // Scheduling
  appointmentDuration Int @default(30) // Duration per appointment in minutes
  bufferTime          Int @default(15) // Buffer time between appointments

  // Services
  servicesOffered   String[] // Services available at this center
  specialFacilities String[] // Special facilities (wheelchair access, etc.)

  // Staff and Management
  managerId String? // Manager user ID
  manager   User?   @relation("CenterManager", fields: [managerId], references: [id])

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Admin who created the center
  lastModifiedBy String? // Last person who modified

  // Relations
  appointments BiometricAppointment[]
  booths       Booth[]
  queueEntries QueueEntry[]

  @@index([city])
  @@index([state])
  @@index([isActive])
  @@index([createdAt])
  @@map("biometric_centers")
}

// Booth Model
model Booth {
  id       String          @id @default(uuid())
  centerId String
  center   BiometricCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  // Booth Details
  boothNumber      String // e.g., "A1", "B2", "VIP-1"
  appointmentClass AppointmentClass // VIP, PREMIUM, REGULAR
  isActive         Boolean          @default(true)
  isOccupied       Boolean          @default(false)

  // Equipment/Capabilities
  hasCamera             Boolean @default(true)
  hasFingerprintScanner Boolean @default(true)
  hasSignaturePad       Boolean @default(false)

  // Current Assignment
  agentId String?
  agent   User?   @relation("BoothAgent", fields: [agentId], references: [id])

  // Relations
  queueEntries      QueueEntry[]
  biometricSessions BiometricSession[]

  // Audit
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  lastModifiedBy String?

  @@unique([centerId, boothNumber])
  @@index([centerId])
  @@index([appointmentClass])
  @@index([isActive, isOccupied])
  @@map("booths")
}

// Queue Entry Model
model QueueEntry {
  id String @id @default(uuid())

  // Appointment Reference
  appointmentId String               @unique
  appointment   BiometricAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Queue Details
  centerId         String
  center           BiometricCenter  @relation(fields: [centerId], references: [id])
  appointmentClass AppointmentClass

  // Queue Position & Status
  queueNumber Int         @default(autoincrement()) // Auto-generated sequential number
  status      QueueStatus @default(WAITING)
  priority    Int         @default(0) // Higher number = higher priority

  // Timestamps
  joinedAt    DateTime  @default(now())
  calledAt    DateTime? // When called to booth
  startedAt   DateTime? // When biometric capture started
  completedAt DateTime? // When biometric capture completed

  // Booth Assignment
  boothId String?
  booth   Booth?  @relation(fields: [boothId], references: [id])

  // Estimated times
  estimatedWaitTime    Int? // In minutes
  estimatedServiceTime Int? // In minutes

  // Relations
  biometricSession BiometricSession?

  @@index([centerId, appointmentClass, queueNumber])
  @@index([status, joinedAt])
  @@index([centerId, status])
  @@map("queue_entries")
}

// Biometric Session Model
model BiometricSession {
  id String @id @default(uuid())

  // References
  appointmentId String               @unique
  appointment   BiometricAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  queueEntryId  String               @unique
  queueEntry    QueueEntry           @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  boothId       String
  booth         Booth                @relation(fields: [boothId], references: [id])
  agentId       String
  agent         User                 @relation("BiometricAgent", fields: [agentId], references: [id])

  // Biometric Data Capture Status
  fingerprintsCaptured Boolean @default(false)
  photoCaptured        Boolean @default(false)
  signatureCaptured    Boolean @default(false)

  // Files/References
  photoUrl        String?
  fingerprintData Json? // Encrypted biometric data
  signatureUrl    String?

  // Session Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int? // In seconds

  // Quality Checks
  photoQualityScore       Float?
  fingerprintQualityScore Float?
  requiresRetake          Boolean @default(false)
  retakeReason            String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([boothId])
  @@index([agentId])
  @@index([startedAt])
  @@map("biometric_sessions")
}

// Biometric Appointment Enums
enum AppointmentClass {
  REGULAR
  VIP
  PREMIUM
}

enum AppointmentStatus {
  PENDING // Initial status when appointment is created
  SCHEDULED // When date/time is set but payment not completed
  ACTIVE // When application is completed AND payment is made
  COMPLETED // When biometric capture is done
  CANCELLED // When appointment is cancelled
  RESCHEDULED // When appointment is rescheduled
  NO_SHOW // When applicant doesn't show up
}

// Biometric Appointment Model
model BiometricAppointment {
  id String @id @default(uuid())

  // Relations
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String         @unique // One appointment per form submission
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Biometric Center Relation (instead of enum)
  centerId String
  center   BiometricCenter @relation(fields: [centerId], references: [id])

  // Appointment Details
  appointmentClass AppointmentClass  @default(REGULAR)
  status           AppointmentStatus @default(PENDING)

  // Date and Time
  appointmentDate DateTime? // Date of the appointment
  appointmentTime DateTime? // Full date-time for the appointment

  // Requirements and Notes
  specialRequirements String? // Any special requirements or accessibility needs
  adminNotes          String? // Internal notes by admin/staff

  // Acknowledgments
  confirmationAcknowledged Boolean @default(false) // User confirmed appointment
  consentAcknowledged      Boolean @default(false) // User gave biometric consent
  termsAcknowledged        Boolean @default(false) // User agreed to terms

  // Reminder System
  reminderSent   Boolean   @default(false) // Whether reminder was sent
  reminderSentAt DateTime? // When reminder was sent

  // Rescheduling History
  originalAppointmentDate DateTime? // Original date if rescheduled
  rescheduleReason        String? // Reason for rescheduling
  rescheduleCount         Int       @default(0) // Number of times rescheduled

  // Biometric Capture Results
  biometricsCaptured Boolean   @default(false) // Whether biometrics were captured
  capturedAt         DateTime? // When biometrics were captured
  capturedBy         String? // Staff member who captured biometrics
  captureQuality     String? // Quality assessment of captured biometrics

  // Relations
  queueEntry       QueueEntry?
  biometricSession BiometricSession?

  // Audit Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Admin/staff who created the appointment
  lastModifiedBy String? // Last person who modified the appointment

  // Indexes for performance
  @@index([userId])
  @@index([submissionId])
  @@index([centerId])
  @@index([appointmentDate])
  @@index([appointmentTime])
  @@index([status])
  @@index([appointmentClass])
  @@index([createdAt])
  @@map("biometric_appointments")
}

// Payment Enums (reusing existing PaymentStatus)
enum Currency {
  USD
  NGN
  EUR
  GBP
}

// Using existing PaymentMethodType enum

// Payment Model
model Payment {
  id String @id @default(uuid())

  // Relations
  submissionId String?         @unique // One payment per form submission
  submission   FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Payment Details
  amount      Float
  currency    Currency           @default(NGN)
  status      PaymentStatus      @default(PENDING)
  methodType  PaymentMethodType? // Type of payment method used
  description String? // What the payment is for

  // Payment Processor Integration
  processorId       String? // Stripe/Paystack/Flutterwave transaction ID
  processor         PaymentProvider? // Which payment processor was used
  processorResponse Json? // Full response from payment processor

  // Payment Metadata
  invoiceNumber String? @unique // Internal invoice number
  reference     String? @unique // payment reference number
  receiptUrl    String? // URL to payment receipt
  refundReason  String? // Reason for refund if applicable
  refundAmount  Float? // Amount refunded

  // Timestamps
  paidAt     DateTime? // When payment was completed
  failedAt   DateTime? // When payment failed
  refundedAt DateTime? // When payment was refunded
  expiresAt  DateTime? // When payment link expires

  // Audit Fields
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String? // Who initiated the payment
  lastModifiedBy  String? // Last person who modified
  PaymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String?

  // Indexes for performance
  @@index([submissionId])
  @@index([status])
  @@index([amount])
  @@index([currency])
  @@index([processorId])
  @@index([paidAt])
  @@index([createdAt])
  @@map("payments")
}
