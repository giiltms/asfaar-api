{
  "name": "nestjs-boilerplate",
  "version": "1.0.0",
  "description": "A comprehensive NestJS boilerplate with authentication, authorization, RBAC, rate limiting, file upload, email services, and more",
  "author": "NestJS Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "dotenv -e .env.test jest",
    "test:watch": "dotenv -e .env.test jest --watch",
    "test:cov": "dotenv -e .env.test jest --coverage",
    "test:debug": "dotenv -e .env.test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv -e .env.test npm run test:config:e2e",
    "test:config:e2e": "jest --config jest-e2e.json --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "ts-node src/seed.ts",
    "db:repair-migrations": "node scripts/fix-migration-state.js",
    "prepare": "husky install"
  },
  "keywords": [
    "nestjs",
    "starter",
    "boilerplate",
    "postgresql",
    "redis",
    "s3",
    "email",
    "authentication",
    "authorization",
    "rbac",
    "rate-limiting",
    "file-upload",
    "payments",
    "paystack",
    "flutterwave",
    "fincra"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.556.0",
    "@aws-sdk/client-sqs": "^3.556.0",
    "@aws-sdk/lib-storage": "^3.565.0",
    "@aws-sdk/s3-request-presigner": "^3.556.0",
    "@casl/ability": "6.5.0",
    "@nestjs-modules/ioredis": "^1.0.1",
    "@nestjs-modules/mailer": "^1.8.1",
    "@nestjs-plus/discovery": "^2.0.2",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "10.0.2",
    "@nestjs/config": "3.0.0",
    "@nestjs/core": "^10.4.19",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "10.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.2",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "7.0.4",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^4.2.1",
    "@nodeteam/nestjs-pipes": "^1.5.1",
    "@nodeteam/nestjs-prisma-pagination": "^1.0.6",
    "@prisma/client": "5.7.1",
    "@ucast/sql": "^1.0.0-alpha.1",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "csv-parse": "^6.1.0",
    "dotenv-cli": "^7.2.1",
    "express-basic-auth": "^1.2.1",
    "handlebars": "^4.7.7",
    "husky": "^8.0.3",
    "ioredis": "^5.3.2",
    "module-alias": "2.2.3",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "sharp": "^0.33.2",
    "sqs-consumer": "7.2.0",
    "sqs-producer": "3.1.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nestjs/cli": "10.0.2",
    "@nestjs/schematics": "10.0.1",
    "@nestjs/testing": "10.0.2",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "4.17.17",
    "@types/jest": "29.5.2",
    "@types/multer": "^1.4.13",
    "@types/node": "20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "2.0.12",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "5.60.0",
    "@typescript-eslint/parser": "5.60.0",
    "eslint": "8.42.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "jest": "29.5.0",
    "prettier": "2.8.8",
    "prisma": "5.7.1",
    "source-map-support": "0.5.21",
    "supertest": "6.3.3",
    "ts-jest": "29.1.0",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "@common(.*)": "<rootDir>/common/$1",
      "@core(.*)": "<rootDir>/core/$1",
      "@shared(.*)": "<rootDir>/shared/$1",
      "@modules(.*)": "<rootDir>/modules/$1",
      "@providers(.*)": "<rootDir>/providers/$1",
      "@tests(.*)": "<rootDir>/tests/$1",
      "@constants(.*)": "<rootDir>/constants/$1"
    }
  },
  "_moduleAliases": {
    "@common": "./src/common",
    "@core": "./src/core",
    "@shared": "./src/shared",
    "@modules": "./src/modules",
    "@providers": "./src/providers",
    "@tests": "./src/tests",
    "@constants": "./src/constants"
  }
}
