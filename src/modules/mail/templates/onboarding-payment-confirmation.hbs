<html>
  <head>
    <meta charset='UTF-8' />
    <title>Onboarding Payment Confirmation - ASFAAR Visa Services</title>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap'
      rel='stylesheet'
    />
    <style>
      body { font-family: 'Inter', sans-serif; background-color: #f9f9f9;
      margin: 0; padding: 0; color: #333; } .container { background-color:
      #ffffff; max-width: 700px; margin: 40px auto; border-radius: 10px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1); overflow: hidden; border-top:
      5px solid #1976d2; } .header { background: linear-gradient(90deg, #1976d2
      0%, #2196f3 100%); padding: 30px; text-align: center; color: white; }
      .header h1 { margin: 0; font-size: 24px; text-transform: uppercase; }
      .section { padding: 30px; line-height: 1.6; } .section h2 { color:
      #1976d2; font-size: 20px; } .success-box { margin: 20px 0; padding: 20px;
      border-radius: 6px; background-color: #f0f8ff; border: 1px solid #1976d2;
      color: #1976d2; font-weight: bold; text-align: center; font-size: 18px; }
      .payment-details { background-color: #f9fafb; border: 1px solid #e5e7eb;
      border-radius: 6px; padding: 20px; margin: 20px 0; } .detail-row {
      padding: 8px 0; } .detail-label { color: #6b7280; font-size: 12px;
      font-weight: 500; margin: 0 0 4px; text-transform: uppercase; }
      .detail-value { color: #1f2937; font-size: 14px; font-weight: 600; margin:
      0; font-family: monospace; } .amount-value { color: #1976d2; font-size:
      16px; } .divider { border-top: 1px solid #e5e7eb; margin: 12px 0; }
      .button { background-color: #1976d2; border-radius: 6px; color: white;
      display: inline-block; font-size: 14px; font-weight: 600; padding: 12px
      24px; text-align: center; text-decoration: none; margin: 20px 0; } .footer
      { font-size: 12px; color: #777; text-align: center; padding: 25px;
      background-color: #f0f8ff; } .footer a { color: #1976d2; text-decoration:
      none; } .greeting { font-size: 16px; font-weight: 500; margin-bottom:
      16px; } .paragraph { margin-bottom: 16px; font-size: 14px; }
      .section-header { color: #1a1a1a; font-size: 16px; font-weight: 600;
      margin: 24px 0 12px; } .signature { margin-top: 24px; font-size: 14px; }
      .next-steps { margin-bottom: 16px; font-size: 14px; } .next-steps li {
      margin-bottom: 8px; }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>ASFAAR VISA SERVICES</h1>
      </div>

      <div class='section'>
        <h2 class='greeting'>Hello {userName},</h2>

        <p class='paragraph'>
          Thank you for your onboarding payment! We've successfully received
          your payment to activate your account. Your account is now fully
          activated and ready for use.
        </p>

        <div class='success-box'>
          Onboarding Payment Successful
        </div>

        <div class='payment-details'>
          <h3 class='section-header'>Payment Details</h3>
          <div class='divider'></div>

          <div class='detail-row'>
            <div class='detail-label'>Payment Reference:</div>
            <div class='detail-value'>{paymentReference}</div>
          </div>

          <div class='detail-row'>
            <div class='detail-label'>Transaction ID:</div>
            <div class='detail-value'>{transactionId}</div>
          </div>

          <div class='detail-row'>
            <div class='detail-label'>Amount Paid:</div>
            <div class='detail-value amount-value'>{currency}
              {amount.toLocaleString()}</div>
          </div>

          <div class='detail-row'>
            <div class='detail-label'>Payment Date:</div>
            <div class='detail-value'>{paymentDate}</div>
          </div>
        </div>

        <h3 class='section-header'>What Happens Next?</h3>
        <ul class='next-steps'>
          <li>Your account is now fully activated</li>
          <li>You can now access all features and services</li>
          <li>Start your visa application process in your dashboard</li>
          <li>You'll receive updates and notifications about your account</li>
        </ul>

        <div style='text-align: center;'>
          <a href='{dashboardUrl}/dashboard' class='button'>
            Access Your Dashboard
          </a>
        </div>

        <p class='paragraph'>
          Please keep this email as your payment receipt. If you have any
          questions about your account activation or payment, please contact our
          support team.
        </p>

        <p class='signature'>
          Best regards,<br />
          The Asfaar Onboarding Team
        </p>
      </div>

      <div class='footer'>
        <p>For inquiries:
          <a
            href='mailto:info@asfaarvisaservices.com'
          >info@asfaarvisaservices.com</a>
          | Visit:
          <a
            href='https://www.asfaarvisaservices.com'
          >www.asfaarvisaservices.com</a></p>
        <p><strong>Hotline:</strong>
          +234 700 700 4001 |
          <strong>Open Hours:</strong>
          Mon-Fri 08:00 - 18:00</p>
      </div>
    </div>
  </body>
</html>