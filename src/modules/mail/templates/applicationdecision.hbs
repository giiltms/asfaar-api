<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Visa Application Decision</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 0;
        color: #333;
      }
      .container {
        background-color: #ffffff;
        max-width: 700px;
        margin: 40px auto;
        border-radius: 10px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        border-top: 5px solid #2e7d32;
      }
      .header {
        background: linear-gradient(90deg, #2e7d32 0%, #388e3c 100%);
        padding: 30px;
        text-align: center;
        color: white;
      }
      .header h1 {
        margin: 0;
        font-size: 24px;
        text-transform: uppercase;
      }
      .section {
        padding: 30px;
        line-height: 1.6;
      }
      .section h2 {
        color: #2e7d32;
        font-size: 20px;
      }
      .decision-box {
        margin: 20px 0;
        padding: 20px;
        border-radius: 6px;
        background-color: #e8f5e9;
        border: 1px solid #c8e6c9;
        color: #2e7d32;
        font-weight: 600;
      }
      .rejected {
        background-color: #ffebee;
        border-color: #ffcdd2;
        color: #c62828;
      }
      .footer {
        font-size: 12px;
        color: #777;
        text-align: center;
        padding: 25px;
        background-color: #f1f8f2;
      }
      .footer a {
        color: #2e7d32;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>ASFAAR VISA SERVICES</h1>
      </div>

      <div class="section">
        <h2>Hello {{userName}},</h2>

        {{#if (eq decision "APPROVED")}}
        <!-- ✅ APPROVED Version -->
        <div class="decision-box">
          ✅ Your visa application has been <strong>approved</strong> by the
          {{embassyName}}.
        </div>
        {{else}}
        <!-- ❌ REJECTED Version -->
        <div class="decision-box rejected">
          ❌ Unfortunately, your visa application has been
          <strong>rejected</strong> by the {{embassyName}}.
        </div>
        {{/if}}

        <p>
          <strong>Reference Number:</strong> {{referenceNumber}}<br />
          <strong>Decision Date:</strong> {{decisionDate}}
        </p>

        {{#if reason}}
        <p><strong>Reason:</strong> {{reason}}</p>
        {{/if}}

        <p>
          If approved, you will be contacted shortly for passport collection or
          further instructions. If your application was rejected and you would
          like to reapply, please contact our support team for assistance.
        </p>

        <p>Thank you for using ASFAAR Visa Services.</p>
      </div>

      <div class="footer">
        <p>
          For inquiries:
          <a href="mailto:info@asfaarvisaservices.com"
            >info@asfaarvisaservices.com</a
          >
          | Visit:
          <a href="https://www.asfaarvisaservices.com"
            >www.asfaarvisaservices.com</a
          >
        </p>
        <p>
          <strong>Hotline:</strong> +234 700 700 4001 |
          <strong>Open Hours:</strong> Mon-Fri 08:00 - 18:00
        </p>
      </div>
    </div>
  </body>
</html>
